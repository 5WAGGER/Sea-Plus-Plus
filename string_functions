#include <iostream>
#include <cctype>
using namespace std;



// Returns the last index where target appears in inString.
// Returns -1 if target does not appear in the string.
int lastIndexOf(const char* inString, char target) {
    int lastIndex = -1;
    int index = 0;

    while (inString[index] != '\0') {
        if (inString[index] == target) {
            lastIndex = index;
        }
        index++;
    }

    return lastIndex;
}




// Reverses the characters in inString in place.
void reverse(char* inString) {
    int front = 0;
    int back = 0;

    while (inString[back] != '\0') {
        back++;
    }
    back--;

    while (front < back) {
        swap(inString[front], inString[back]);
        front++;
        back--;
    }
}




// Replaces every occurrence of target in inString with replacementChar.
// Returns the number of replacements made.
int replace(char* inString, char target, char replacementChar) {
    int count = 0;
    int index = 0;

    while (inString[index] != '\0') {
        if (inString[index] == target) {
            inString[index] = replacementChar;
            count++;
        }
        index++;
    }

    return count;
}




// Returns true if inString is a palindrome, ignoring letter case.
// Returns false otherwise.
bool isPalindrome(const char* inString) {
    int front = 0;
    int back = 0;

    while (inString[back] != '\0') {
        back++;
    }
    back--;

    while (front < back) {
        if (tolower(inString[front]) != tolower(inString[back])) {
            return false;
        }
        front++;
        back--;
    }

    return true;
}




// Converts every letter in inString to uppercase.
void toupper(char* inString) {
    int index = 0;

    while (inString[index] != '\0') {
        inString[index] = toupper(inString[index]);
        index++;
    }
}




// Returns the number of alphabetic letters in inString.
int numLetters(const char* inString) {
    int count = 0;
    int index = 0;

    while (inString[index] != '\0') {
        if (isalpha(inString[index])) {
            count++;
        }
        index++;
    }

    return count;
}




